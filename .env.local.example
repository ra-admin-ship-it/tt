# 簡易ログイン用パスワード（社内共有用、デフォルトはdev）
APP_PASSWORD=dev

# Cookie署名用シークレット（任意の長い文字列）
SESSION_SECRET=please-change-this-to-a-long-random-string

# 国税庁 法人番号システムWeb-API のアプリケーションID
# https://www.houjin-bangou.nta.go.jp/webapi/ から取得
HOUJIN_BANGOU_APP_ID=

# Supabase（Supabaseに切り替えたい場合に設定）
# Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# anon key はサーバー側からはほぼ使わないが、将来クライアント側で使う場合に備えて
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel Cron で keepalive を叩く際の認証シークレット（任意の長いランダム文字列）
# Vercel に設定すれば、Vercel Cron が自動で Authorization ヘッダに乗せて送ってくれる
CRON_SECRET=
